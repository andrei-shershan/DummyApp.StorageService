{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to .NET in Docker",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [
          "exec",
          "-i",
          "dummyappdocker-storage-1",
          "sh",
          "-lc"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceFolder}",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/app": "${workspaceFolder}/src/DummyApp.StorageService.WebApi"
      }
    }
  ]
}
