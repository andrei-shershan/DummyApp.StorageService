{
  "IdentityServer": {
    "Authority": "https://identity.dummy.localhost",
    "Audience": "DummyApp.StorageService"
  },
  "Infrastructure": {
    "Databases": {
      "Storage": {
        "UseInMemory": false,
        "ConnectionString": "server=mysql;port=3306;database=dummy_db;user=dummyapp;password=secret",
        "SeedPricesAndSizes": false
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.IdentityModel": "Debug"
    }
  },
  "AllowedHosts": "*"
}